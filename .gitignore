# Build artifacts
/build/
/output/

# Test coverage
coverage.out
coverage.html

# Build profile (--profile=json)
build-profile.json

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Go
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
vendor/

# Compiled ssg binary (never commit build artifacts — see #73 Binary-Artifacts)
/ssg
/ssg-*

# Logs
*.log

# Temporary files
tmp/
temp/

# Content (except test-content for CI)
content/*
!content/test-content/

# Archive deployments (--zip / --targz / --tarxz)
*.zip
*.tar.xz

# Distribution/Packaging
/dist/
*.deb
*.rpm
*.snap
*.tar.gz
/.claude/
/.claude/*
/.agent/
/.agent/*
# Downloaded themes (created by --online-theme)
templates/gohugo-*/
templates/hugo-*/

# Audit reports (local only)
/audit/

# Image-processing cache (v1.8.3)
.ssg-cache/

# Example project build artifacts
examples/*/output/

# Documentation site built by `make site` from docs/ (.ssg.yaml)
.site/

# Local wrangler dev artifacts (miniflare state, generated config)
.wrangler/
/wrangler.toml
# Running wrangler inside a worker template (e.g. `npx wrangler dev` in
# workers/newsletter-ui): local secrets, an npm install, generated types.
# go:embed takes everything under workers/, so none of it may sit there.
.dev.vars
.dev.vars.*
node_modules/
worker-configuration.d.ts

# Build-throughput benchmark corpora (scripts/bench-build.sh, make bench)
ssg-bench/

# Tools built by the Makefile (make security builds the locked gosec here)
.cache/
CLAUDE.md
