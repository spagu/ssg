# smtp-relay settings for docker compose. Copy to .env and edit.
# Passwords never go here: they live in ./secrets/ (see docker-compose.yml).

# This server's fully qualified name: the PTR record of its IP, the name on
# the TLS certificate and NEWSLETTER_SMTP_HOST all say this.
SMTP_HOSTNAME=relay.example.com

# direct    deliver to recipients' MX (needs outbound 25, static IP, PTR)
# smarthost hand everything to RELAYHOST (when outbound 25 is blocked)
# hold      accept, sign and keep; nothing leaves (first tests)
RELAY_MODE=hold

# Domains you send from (the From / MAIL FROM domain); one DKIM key each.
DKIM_DOMAINS=example.com
DKIM_SELECTOR=relay
# Allowed MAIL FROM domains; empty = DKIM_DOMAINS.
SENDER_DOMAINS=

# The login the Worker uses (NEWSLETTER_SMTP_USER); its password is
# ./secrets/smtp_password (NEWSLETTER_SMTP_PASSWORD).
SMTP_USER=newsletter

# RELAY_MODE=smarthost only. Brackets: connect to this host, no MX lookup.
# Password in ./secrets/relayhost_password.
RELAYHOST=
RELAYHOST_USER=

# Certificate directory on the host (fullchain.pem + privkey.pem).
TLS_DIR=./tls
CERT_CHECK_INTERVAL=300

# ipv4, ipv6 or all. "all" only when the host really has IPv6 with a PTR.
INET_PROTOCOLS=ipv4

# Use a published image instead of building locally:
# SMTP_RELAY_IMAGE=ghcr.io/spagu/ssg-smtp-relay:1
