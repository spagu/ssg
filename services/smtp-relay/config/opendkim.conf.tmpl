# OpenDKIM — generated by bin/render-config.sh from config/opendkim.conf.tmpl.
# Signs only (Mode s): mail Postfix's submission services mark ORIGINATING,
# or mail from this host. One key per DKIM_DOMAINS entry, selector
# DKIM_SELECTOR.
Mode                    s
MTA                     ORIGINATING
InternalHosts           127.0.0.1, ::1
Socket                  inet:8891@127.0.0.1
UserID                  opendkim
# Debian's opendkim.service (Type=forking) waits for this file.
PidFile                 /run/opendkim/opendkim.pid
UMask                   007
Syslog                  yes
SyslogSuccess           yes
LogWhy                  yes

KeyTable                file:@@RUN_DIR@@/dkim-keytable
SigningTable            file:@@RUN_DIR@@/dkim-signingtable
RequireSafeKeys         yes
Canonicalization        relaxed/relaxed
SignatureAlgorithm      rsa-sha256

# A newsletter's signature must cover the RFC 8058 one-click unsubscribe
# headers, or receivers ignore them. Oversigning From and the list headers
# stops anyone from adding a second copy after signing.
SignHeaders             From,Sender,Reply-To,Subject,Date,Message-ID,To,Cc,MIME-Version,Content-Type,Content-Transfer-Encoding,In-Reply-To,References,List-Id,List-Unsubscribe,List-Unsubscribe-Post
OversignHeaders         From,Subject,List-Unsubscribe,List-Unsubscribe-Post
