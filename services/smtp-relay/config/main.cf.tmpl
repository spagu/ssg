# main.cf for smtp-relay — generated by bin/render-config.sh from
# config/main.cf.tmpl. Edit the template (or the environment), not this file:
# it is rewritten on every start.
#
# What this server is: a SUBMISSION server (ports 465 and 587, RFC 6409 /
# RFC 8314) for your own sending. Every client must log in over TLS; mail is
# then relayed to the recipients' MX (RELAY_MODE=direct), through a smarthost
# (RELAY_MODE=smarthost) or held (RELAY_MODE=hold). It never accepts mail for
# local delivery and does not listen on port 25.

# The installed Postfix's own major.minor (render-config.sh reads it): the
# newest, safest defaults, on Alpine and Debian alike.
compatibility_level = @@COMPATIBILITY_LEVEL@@

myhostname = @@SMTP_HOSTNAME@@
myorigin = $myhostname
smtpd_banner = $myhostname ESMTP
inet_interfaces = all
inet_protocols = @@INET_PROTOCOLS@@
# Loopback only. Nothing is permitted for being on this list (the relay
# restrictions below only know permit_sasl_authenticated); it only exempts the
# container itself from the anvil rate limits.
mynetworks = 127.0.0.0/8 [::1]/128

# No local mailboxes: nothing is ever delivered on this host.
mydestination =
local_recipient_maps =
local_transport = error:5.1.1 local delivery is disabled on this relay
alias_maps =
alias_database =
biff = no
append_dot_mydomain = no
disable_vrfy_command = yes
smtpd_helo_required = yes

# ---------------------------------------------------------------- SASL (server)
# Cyrus SASL reading the sasldb the renderer builds from SMTP_PASSWORD_FILE.
# Enabled per service in master.cf (submission and submissions only).
cyrus_sasl_config_path = @@POSTFIX_DIR@@/sasl
smtpd_sasl_type = cyrus
smtpd_sasl_path = smtpd
smtpd_sasl_local_domain = $myhostname
smtpd_sasl_security_options = noanonymous, noplaintext
smtpd_sasl_tls_security_options = noanonymous
broken_sasl_auth_clients = no

# ---------------------------------------------------------------- who may send
# Not an open relay: only an authenticated client may relay, and only with a
# MAIL FROM in SENDER_DOMAINS (the DKIM domains unless set otherwise).
smtpd_relay_restrictions = permit_sasl_authenticated, reject
# RECIPIENT_DOMAIN_CHECK: reject_unknown_recipient_domain (a domain with no MX
# or a null MX, RFC 7505, is refused at once instead of bouncing later),
# except in RELAY_MODE=hold, where nothing is delivered.
smtpd_recipient_restrictions = reject_non_fqdn_recipient, @@RECIPIENT_DOMAIN_CHECK@@ permit_sasl_authenticated, reject
smtpd_sender_restrictions = reject_non_fqdn_sender, check_sender_access texthash:@@RUN_DIR@@/sender-domains, reject

# ---------------------------------------------------------------- TLS (server)
# One file pair; Postfix reads the key first, then the certificate chain
# (leaf first). Below TLS 1.2 is refused (RFC 8996).
smtpd_tls_chain_files = @@TLS_KEY_FILE@@, @@TLS_CERT_FILE@@
smtpd_tls_security_level = may
smtpd_tls_auth_only = yes
smtpd_tls_protocols = >=TLSv1.2
smtpd_tls_mandatory_protocols = >=TLSv1.2
smtpd_tls_loglevel = 1
smtpd_tls_received_header = yes

# ---------------------------------------------------------------- TLS (client)
smtp_tls_CAfile = /etc/ssl/certs/ca-certificates.crt
smtp_tls_protocols = >=TLSv1.2
smtp_tls_mandatory_protocols = >=TLSv1.2
smtp_tls_loglevel = 1

# ---------------------------------------------------------------- DKIM
# OpenDKIM signs mail the submission services mark ORIGINATING. If it is
# down, mail is deferred (tempfail), never sent unsigned.
smtpd_milters = inet:127.0.0.1:8891
non_smtpd_milters = $smtpd_milters
milter_default_action = tempfail
milter_protocol = 6

# ---------------------------------------------------------------- limits
# Per client IP, per anvil_rate_time_unit (one minute). See README "Limits".
anvil_rate_time_unit = 60s
smtpd_client_connection_rate_limit = @@LIMIT_CONNECTIONS_PER_MINUTE@@
smtpd_client_connection_count_limit = @@LIMIT_CONCURRENT_CONNECTIONS@@
smtpd_client_message_rate_limit = @@LIMIT_MESSAGES_PER_MINUTE@@
smtpd_client_recipient_rate_limit = @@LIMIT_RECIPIENTS_PER_MINUTE@@
smtpd_client_auth_rate_limit = @@LIMIT_AUTH_PER_MINUTE@@
smtpd_client_event_limit_exceptions = $mynetworks
smtpd_error_sleep_time = 1s
smtpd_soft_error_limit = 3
smtpd_hard_error_limit = 5
smtpd_recipient_limit = 100
message_size_limit = @@MESSAGE_SIZE_LIMIT@@

# Processes per service (smtpd, smtp, ...). Postfix's default of 100 is
# sized for a busy mail host; 20 keeps a 512 MB board comfortable and is
# plenty for one newsletter.
default_process_limit = @@PROCESS_LIMIT@@

# Outbound: be polite to large receivers, give up on a newsletter after
# QUEUE_LIFETIME instead of Postfix's five days.
smtp_destination_concurrency_limit = @@OUTBOUND_CONCURRENCY@@
maximal_queue_lifetime = @@QUEUE_LIFETIME@@
bounce_queue_lifetime = @@QUEUE_LIFETIME@@
