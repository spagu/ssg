# /etc/smtp-relay/smtp-relay.env — native install (docs/SMTP-SERVER-PI.md).
# Same variables as the image (README.md, "Configuration"); the last block
# holds the Debian paths that differ from Alpine's. chmod 640, owner root.

SMTP_HOSTNAME=relay.example.com
# direct | smarthost | hold — a home connection usually means smarthost.
RELAY_MODE=hold
DKIM_DOMAINS=example.com
DKIM_SELECTOR=relay
SMTP_USER=newsletter
SMTP_PASSWORD_FILE=/etc/smtp-relay/secrets/smtp_password

# RELAY_MODE=smarthost
RELAYHOST=
RELAYHOST_USER=
RELAYHOST_PASSWORD_FILE=/etc/smtp-relay/secrets/relayhost_password

TLS_CERT_FILE=/etc/smtp-relay/tls/fullchain.pem
TLS_KEY_FILE=/etc/smtp-relay/tls/privkey.pem
INET_PROTOCOLS=ipv4

# 512 MB: fewer Postfix processes than the default 100.
PROCESS_LIMIT=10

# Debian / Raspberry Pi OS
OPENDKIM_CONF=/etc/opendkim.conf
