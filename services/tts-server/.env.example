# tts-server configuration. Copy to .env and edit; never commit .env.
# Every variable is optional; the value shown is the default.

# --- Auth ---------------------------------------------------------------
# Comma-separated bearer keys for /v1/speech and /v1/voices. Empty = no auth
# (the server logs a warning). Generate one with: openssl rand -hex 32
TTS_API_KEYS=
# Comma-separated keys allowed to upload/delete voices. Empty = voice
# management disabled (403). Admin keys also work as API keys.
TTS_ADMIN_KEYS=

# --- Limits -------------------------------------------------------------
# Longest accepted text, in characters (400 text_too_long above it).
TTS_MAX_CHARS=20000
# Syntheses running at once (default: number of CPUs).
#TTS_MAX_CONCURRENCY=
# Requests allowed to wait for a slot (default: number of CPUs); more get 503.
#TTS_QUEUE_SIZE=
# Longest wait for a slot before 503 busy.
TTS_QUEUE_TIMEOUT=10s
# Per-request synthesis deadline (504 timeout after it).
TTS_TIMEOUT=60s
# Requests per minute per key (or per client IP without auth); 0 disables.
TTS_RATE_LIMIT=60
# Token-bucket burst size.
TTS_RATE_BURST=10
# Largest accepted voice model upload, in MiB.
TTS_MAX_UPLOAD_MB=256

# --- Voices and cache ---------------------------------------------------
# Language used when a request names neither voice nor lang.
TTS_DEFAULT_LANG=en
# Piper models (<id>.onnx + <id>.onnx.json) and optional voices.yaml.
TTS_VOICES_DIR=/voices
# On-disk audio cache; empty keeps the cache in memory.
TTS_CACHE_DIR=/cache
# Cache budget in MiB; 0 disables caching.
TTS_CACHE_MB=128

# --- Binaries (the image sets these; change only for custom builds) -------
#TTS_ESPEAK_BIN=espeak-ng
#TTS_PIPER_BIN=/opt/piper/piper
#TTS_LAME_BIN=lame

# --- Server -------------------------------------------------------------
TTS_ADDR=:8080
# debug, info, warn, error
TTS_LOG_LEVEL=info

# --- docker compose only ------------------------------------------------
# Host port (bound to 127.0.0.1).
TTS_PORT=8080
# CPU limit for the container.
TTS_CPUS=2
# Piper voices to bake into the image at build time (see voices.sha256).
WITH_VOICES=en_US-lessac-medium,pl_PL-gosia-medium
