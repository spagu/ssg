# Build artifacts
/build/
/output/
examples/*/output/
/ssg
/ssg-*

# Git
.git/
.gitignore

# Documentation
README.md
CHANGELOG.md
LICENSE
docs/

# Development
.idea/
.vscode/
*.md
Makefile

# Tests
*_test.go
coverage.*

# Agent/IDE config
.agent/

# GitHub Actions
.github/

# Archive outputs
*.zip
*.tar.gz
*.tar.xz

# Audit reports (local only)
audit/

# Build profile (--profile=json)
build-profile.json

# Build caches, including the dependency graph (--incremental)
.ssg-cache/
.ai-cache/

# Worker tooling and local secrets — the image builds the Go binary, not the
# workers, whose runtime has no dependencies anyway.
workers/*/node_modules/
workers/*/coverage/
.dev.vars
.wrangler/
